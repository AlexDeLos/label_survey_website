Bootstrap: docker
From: python:3.11-slim-bookworm

%labels
    Author      alexdelossanto
    Project     label_survey_website
    Python      3.11

%files
    label_evaluation/requirements.txt /opt/requirements.txt

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PYTHONUNBUFFERED=1

%post
    pip install --no-cache-dir --upgrade pip
    pip install --no-cache-dir -r /opt/requirements.txt
    python -c "import pandas, streamlit, sqlalchemy, psycopg, bcrypt; print('Python imports OK')"

%runscript
    exec python "$@"

%test
    python -c "import pandas, streamlit, sqlalchemy, psycopg, bcrypt; print('All imports OK')"
